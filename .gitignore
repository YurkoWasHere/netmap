# secrets and local state: device logins live in the database; config.json is per install
server/netmap.db*
server/*.db
server/*.db-*
server/config.json
server/*.tmp
# dependencies, the private Node.js copy from install.sh --with-node, build output
node_modules/
/node/
web/dist/
# editors and OS
.DS_Store
*.swp
.vscode/
.idea/
# instances: one folder per deployed site (where it runs, its config, notes); private, never committed,
# except the README and the example template
/instances/*
!/instances/README.md
!/instances/example/

# scripts/deploy.sh reads this (it's a shell file).
SSH_TARGET=user@192.0.2.10          # ssh destination; key login without a password prompt
REMOTE_DIR=/home/user/netmap        # where netmap lives there
PORT=8090                           # for the check after deploying (same as config.json)
# Flags for scripts/install.sh on the instance:
#   --with-node   use a private Node.js in REMOTE_DIR/node (when the system has none, or an old one)
#   --service     (re)install the systemd unit and restart it; needs passwordless sudo there
INSTALL_FLAGS="--with-node --service"
# How to restart after installing: systemctl (needs passwordless sudo), kill (no sudo: SIGKILL the service and
# let systemd's Restart=on-failure start it again), or none (--service already restarted it)
RESTART=none
